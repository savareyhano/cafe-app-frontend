# Backend base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:3000
# Shown in the header, sign-in page and invoices
VITE_CAFE_NAME=Kafe
# Optional: square logo image URL; an initials circle is shown without it
VITE_CAFE_LOGO_URL=
# Optional: address line on the order page and invoices
VITE_CAFE_ADDRESS=
# Optional: Google review link. Enables the footer link and the rate-us popup.
VITE_GOOGLE_REVIEW_URL=
# Midtrans Snap client key (Settings > Access Keys). Online payments open in a popup with it,
# or on Midtrans's own page without it.
VITE_MIDTRANS_CLIENT_KEY=
# "true" for the live Midtrans environment; anything else uses the sandbox
VITE_MIDTRANS_PRODUCTION=false
